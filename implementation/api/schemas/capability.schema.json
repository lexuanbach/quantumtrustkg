{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantumtrustkg.io/schemas/capability.schema.json",
  "title": "CryptoCapabilityProfile",
  "type": "object",
  "required": [
    "algorithms"
  ],
  "properties": {
    "workloadSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "algorithms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string"
    },
    "freshnessSeconds": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
